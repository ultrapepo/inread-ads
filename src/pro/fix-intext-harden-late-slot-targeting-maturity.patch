           previous?.observation === observation;
         blockingStability.set(key, {
           fingerprint: keyState.fingerprint,
@@ -1922,7 +1939,7 @@ class IntextManager {
           polls: maturity.observationEligible ? (unchanged ? previous.polls + 1 : 1) : 0,
