+        hasUeDfpSignal: hasSource("ueDFPData.customTargeting"),
+        hasGptPageSignal: hasSource("gpt-page-targeting"),
+        hasGptSlotSignal: entry.slotsMatched > 0 && hasSource("gpt-slot-targeting"),
