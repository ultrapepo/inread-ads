@@ -1712,6 +1729,40 @@ class IntextManager {
       resolutions,
       fingerprint,
       blockingFingerprint,
+      blockingKeyStates,
+    };
+  }
+
+  getIntextBlockingKeyMaturity({
+    key,
+    context = null,
+    resolution,
+    nativeSlots,
+    keyState,
+    stability,
+  }) {
+    const scoped = Boolean(context?.rootElement);
+    const slotsObserved = nativeSlots.length > 0 && keyState?.slotsChecked > 0;
+    const ownSlotSignal = slotsObserved && keyState?.hasGptSlotSignal === true;
+    // A global value cannot certify missing slot targeting before this runtime is ready.
+    // Scoped observations are tied to the actual article slots by the wait-local tracker.
+    const absenceRuntimeMature = scoped
+      ? slotsObserved
+      : resolution.api?.pubadsReady === true &&
+        (slotsObserved || (nativeSlots.length === 0 && keyState?.resolved === true));
+    const observationEligible = ownSlotSignal || absenceRuntimeMature;
+    const stabilityPolls = stability && stability.fingerprint === keyState?.fingerprint ? stability.polls : 0;
+    const mature = observationEligible && stabilityPolls >= 2;
+    return {
+      key,
+      status: mature ? (keyState.resolved ? "resolved-mature" : "absent-mature") : "pending",
+      mature,
+      observationEligible,
+      reason: mature
+        ? (ownSlotSignal ? "stable-own-slot-targeting" :
+          keyState.resolved ? "stable-global-after-runtime-ready" : "stable-absent-after-runtime-ready")
+        : (keyState?.resolved && !ownSlotSignal ? "global-signal-slot-not-mature" : "blocking-key-not-mature"),
+      stabilityPolls,
     };
   }
 
